{
  "manifest_version": 3,
  "name": "當沖吧！牛馬仔 - 工位摸魚看盤神器 ｜ 台股行情觀察",
  "version": "2.0.0",
  "minimum_chrome_version": "116",
  "description": "低調看盤：台股自選行情、加權／櫃買指數與量能變化觀察，可用 Google 帳號同步自選。行情僅供參考，非投資建議。",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "identity"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/jimmyeyes03160729/easystock/*",
    "https://easystock-c237a-default-rtdb.firebaseio.com/*",
    "https://mis.twse.com.tw/*",
    "https://tw.stock.yahoo.com/*",
    "https://query1.finance.yahoo.com/*",
    "https://query2.finance.yahoo.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "當沖吧！牛馬仔 - 台股行情觀察",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://jimmyeyes03160729.github.io/easystock/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "version_name": "2.0"
}
