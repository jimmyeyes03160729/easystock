[Unit]
Description=EasyStock E.SUN read-only index market data
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/easystock/vm_runtime/esun_marketdata
Environment=EASYSTOCK_MARKET_DATA_DIR=/home/ubuntu/easystock-market-data
EnvironmentFile=-/etc/easystock/esun/credentials.env
ExecStart=/usr/bin/node /home/ubuntu/easystock/vm_runtime/esun_marketdata/provider.js
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/easystock-market-data
PrivateTmp=true
MemoryMax=256M

[Install]
WantedBy=multi-user.target
