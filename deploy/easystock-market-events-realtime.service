[Unit]
Description=EasyStock market events realtime poll (MOPS today's announcements)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/easystock
Environment=EASYSTOCK_MARKET_EVENTS_DIR=/home/ubuntu/easystock-market-events
ExecStart=/home/ubuntu/easystock/.venv/bin/python -m market_events.tracker --realtime-only
TimeoutStartSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
