[Unit]
Description=EasyStock A accepted-signal pattern and market learning (offline)
After=easystock-learning.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/easystock
ExecStart=/home/ubuntu/easystock/.venv/bin/python -m daytrade_learning.a_signal_learning
TimeoutStartSec=300
Nice=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
