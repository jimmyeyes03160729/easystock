# EasyStock Codex NAS 開發節點環境變數範例
# 複製此檔案為 .env 並填寫實際內容：cp .env.example .env

# 時區設定
TZ=Asia/Taipei

# Git 提交者資訊（必須設定）
GIT_AUTHOR_NAME=Jimmy
GIT_AUTHOR_EMAIL=replace-with-your-github-email

# NAS 主機端放置 GitHub SSH 憑證的絕對路徑（必須設定）
# 該目錄下必須包含：
#   - id_ed25519 (Codex 獨立專用的 GitHub SSH 私鑰，權限建議 600)
#   - known_hosts (包含 github.com 的已知主機指紋)
GITHUB_AUTH_DIR=/volume1/docker/easystock-codex/secrets/github
